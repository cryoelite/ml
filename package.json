{
  "name": "gradient",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/vendor-pyodide.mjs --quiet && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "kernel": "bash scripts/kernel.sh",
    "setup": "bash scripts/setup.sh",
    "vendor": "bun scripts/vendor-pyodide.mjs",
    "check:links": "bun run build && uv run --project lab python scripts/check_links.py",
    "check:cells": "uv run --project lab python scripts/check_cells.py --deep",
    "notebooks": "uv run --project lab python scripts/export_notebooks.py"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "astro": "^7.3.1",
    "katex": "^0.18.7",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pyodide": "314.0.6",
    "typescript": "^6"
  }
}
