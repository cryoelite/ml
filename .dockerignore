# Build context hygiene. Without this the 54 MB vendored Pyodide, node_modules
# and lab/.venv all get shipped to the daemon on every build — slow, and they
# are regenerated inside the image anyway.

.git
.gitignore
node_modules
dist
.astro
.ruff_cache
**/__pycache__
**/.ruff_cache

# Regenerated by scripts/vendor-pyodide.mjs during the image build.
public/pyodide

# Host virtualenv: platform-specific, and `uv sync` rebuilds it in the image.
lab/.venv

# Editor / OS noise
.DS_Store
*.log
.vscode
.idea
