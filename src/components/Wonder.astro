---
/**
 * The zoom-out.
 *
 * Every so often a subject stops being a set of mechanics for a moment and is
 * just lovely, and saying so out loud is part of teaching it. This is the box
 * for that: the connection to something far away, the fact that lands, the
 * reason somebody bothered in the first place.
 *
 * Never load-bearing. Always open — a reader should stumble into these, not
 * have to go looking.
 */
import Doodle from "./Doodle.astro";
import Portrait from "./Portrait.astro";

interface Props {
  title?: string;
}
const { title = "Isn't that lovely" } = Astro.props;
---
<aside class="wonder">
  <span class="wonder__spark"><Doodle name="sparkle" decorative /></span>
  <Portrait who="wren" class="wonder__face" />
  <p class="wonder__label">{title}</p>
  <div class="wonder__body"><slot /></div>
</aside>
