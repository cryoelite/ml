---
/**
 * A classified sidenote. The type is the point: a reader should be able to tell
 * at a glance whether a box is load-bearing or a pleasant detour, and after one
 * chapter they read the colour without reading the label.
 *
 *   key   — the sentence to carry out of this section
 *   nice  — a sibling idea, a dead end, some history. Skippable by design.
 *   rust  — for readers who already program. Folded shut, because most
 *           readers don't, and an aside about Rust in front of somebody who
 *           has never written a line of code is just a wall.
 *   warn  — a place people reliably get hurt
 *   math  — a notational aside, not a derivation (use <Reveal kind="math"> for those)
 */
import Portrait from "./Portrait.astro";

interface Props {
  type?: "key" | "nice" | "rust" | "warn" | "math";
  title?: string;
}
const { type = "nice", title } = Astro.props;
const DEFAULTS: Record<string, string> = {
  key: "Worth keeping",
  nice: "Nice to know, not needed",
  rust: "If you already write code",
  warn: "Careful here",
  math: "About the notation",
};
const label = title ?? DEFAULTS[type];
---
{
  type === "rust" ? (
    <details class="aside aside--rust">
      <summary>
        <span class="aside__label">{label}</span>
        <span class="aside__hint">skip freely — nothing later needs it</span>
      </summary>
      <div class="aside__body"><slot /></div>
    </details>
  ) : (
    <aside class={`aside aside--${type}`}>
      {type === "warn" && <Portrait who="basil" class="aside__face" />}
      <span class="aside__label">{label}</span>
      <slot />
    </aside>
  )
}
