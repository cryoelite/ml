---
/**
 * An optional lesson: useful content outside the main learning path.
 *
 * Keep optional material available without making it a prerequisite for the
 * main learning path. The summary tells the reader why and how long the section
 * may take.
 */
import Doodle from "./Doodle.astro";

interface Props {
  title: string;
  /** Rough reading time, so the reader can decide before committing. */
  time?: string;
  /** One line: why a person would want this. Shown on the closed button. */
  why?: string;
  open?: boolean;
}
const { title, time, why, open = false } = Astro.props;
---
<details class="quest" open={open}>
  <summary>
    <span class="quest__icon"><Doodle name="seedling" decorative /></span>
    <span class="quest__text">
      <span class="quest__title">{title}</span>
      {why && <span class="quest__why">{why}</span>}
    </span>
    <span class="quest__meta">
      {time && <span class="quest__time">{time}</span>}
      <span class="quest__chev" aria-hidden="true"></span>
    </span>
  </summary>
  <div class="quest__body"><slot /></div>
</details>
