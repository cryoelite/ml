---
/**
 * The runtime switch, parked in the masthead.
 *
 * Deliberately visible on every page even when there is nothing to run, because
 * the single most confusing thing about an executable tutorial is not knowing
 * *where* your code is about to execute.
 */
import { withBase } from "../lib/base";
---
<div class="runtime">
  <button class="runtime__btn" type="button" aria-haspopup="dialog">
    <span class="runtime__dot" data-state="idle"></span>
    <span class="runtime__label">Browser</span>
  </button>

  <dialog class="runtime__panel" aria-label="Python runtime settings">
    <h3>Where should Python run?</h3>
    <p class="runtime__detail">not started</p>

    <div class="runtime__choice">
      <label>
        <input type="radio" name="backend" value="browser" />
        <span>
          <strong>In this browser</strong>
          <em>
            Pyodide (CPython 3.14 on WebAssembly). No install, works offline and
            when deployed. Ships numpy, pandas, scikit-learn, scipy, matplotlib,
            sympy — but <b>not</b> PyTorch.
          </em>
        </span>
      </label>

      <label>
        <input type="radio" name="backend" value="local" />
        <span>
          <strong>On this machine</strong>
          <em>
            A real Jupyter kernel over its websocket API — running on
            <strong>your</strong> machine, not this site's server. Full PyTorch and
            Apple MPS. Start one with <code>bun run kernel</code>, or see the
            <a href={withBase("/setup/")}>setup guide</a> if you have not yet.
          </em>
          <span class="runtime__field">
            <input name="url" type="url" aria-label="Jupyter server URL" spellcheck="false" />
          </span>
          <span class="runtime__field">
            <input name="token" type="text" aria-label="Jupyter token" spellcheck="false" />
          </span>
          <span class="runtime__test">
            <button class="cell__btn runtime__probe" type="button">Test connection</button>
            <output class="runtime__result" data-kind="" aria-live="polite"></output>
          </span>
        </span>
      </label>
    </div>

    <p>
      <button class="cell__btn runtime__restart" type="button">Restart runtime</button>
      &nbsp;<a href={withBase("/setup/")}>Setup guide →</a>
    </p>
  </dialog>
</div>
