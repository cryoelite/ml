---
/**
 * The linear spine, grouped into parts. Order is `order`, always — the reading
 * path is the product, and the nav should never suggest otherwise.
 */
import { getCollection } from "astro:content";

const current = Astro.props.current as string | undefined;
const chapters = (await getCollection("chapters", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const PARTS: { id: string; label: string }[] = [
  { id: "orientation", label: "Part I · Getting our bearings" },
  { id: "foundations", label: "Part II · How learning happens" },
  { id: "deep-learning", label: "Part III · Neural networks" },
  { id: "frontier", label: "Part IV · The modern stack" },
  { id: "practice", label: "Part V · Doing it for real" },
];
import { withBase } from "../lib/base";
---

<nav class="sidebar" aria-label="Chapters">
  {
    PARTS.map((part) => {
      const items = chapters.filter((c) => c.data.part === part.id);
      if (!items.length) return null;
      return (
        <>
          <p class="nav-part">{part.label}</p>
          <ul class="nav-list">
            {items.map((c) => (
              <li>
                <a
                  href={withBase(`/learn/${c.id}/`)}
                  aria-current={c.id === current ? "page" : undefined}
                >
                  <span class="nav-num">{String(c.data.order).padStart(2, "0")}</span>
                  <span>{c.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      );
    })
  }

  <p class="nav-part">Appendices</p>
  <ul class="nav-list">
    <li><a href={withBase("/appendix/python/")} aria-current={current === "appendix-python" ? "page" : undefined}><span class="nav-num">Py</span><span>The Python we use</span></a></li>
    <li><a href={withBase("/appendix/math/")} aria-current={current === "appendix-math" ? "page" : undefined}><span class="nav-num">∑</span><span>The maths, derived</span></a></li>
    <li><a href={withBase("/map/")} aria-current={current === "map" ? "page" : undefined}><span class="nav-num">◇</span><span>The map</span></a></li>
  </ul>

  <p class="nav-part">Meta</p>
  <ul class="nav-list">
    <li><a href={withBase("/setup/")} aria-current={current === "setup" ? "page" : undefined}><span class="nav-num">⚙</span><span>Setup</span></a></li>
    <li><a href={withBase("/colophon/")} aria-current={current === "colophon" ? "page" : undefined}><span class="nav-num">§</span><span>Colophon</span></a></li>
  </ul>
</nav>
