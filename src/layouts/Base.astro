---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import RuntimeWidget from "../components/RuntimeWidget.astro";
import Doodle from "../components/Doodle.astro";
import { VERSION, VERSION_LABEL } from "../lib/version";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const {
  title,
  description = "A slow, friendly walk through how machines learn. Sixteen chapters, no programming experience needed, and nearly all the code runs in the page.",
} = Astro.props;
const full = title === "Gradient" ? title : `${title} · Gradient`;
import { withBase } from "../lib/base";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={`Gradient ${VERSION}`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <!-- Pyodide is fetched only when a cell runs; warm the connection early. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <!--
      One filter, applied to every drawing on the site. The turbulence displaces
      each path by a pixel or so, which is the whole trick: geometrically exact
      shapes come out looking like somebody drew them, and they all look like
      the *same* somebody.
    -->
    <svg class="svg-defs" aria-hidden="true" focusable="false">
      <filter id="pencil" x="-8%" y="-8%" width="116%" height="116%"
              filterUnits="objectBoundingBox">
        <feTurbulence type="fractalNoise" baseFrequency="0.028" numOctaves="3"
                      seed="7" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.7"
                           xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <header class="masthead">
      <button class="nav-toggle" type="button" aria-expanded="false" aria-label="Toggle chapter list">
        ☰ <span>Chapters</span>
      </button>
      <a class="masthead__brand" href={withBase("/")}>
        <span class="masthead__mark"><Doodle name="pip" decorative /></span>
        <span class="masthead__name">Gradient</span>
        <span class="masthead__version" title={`Version ${VERSION}`}>{VERSION_LABEL}</span>
        <span class="masthead__tag">how machines learn, from the beginning</span>
      </a>
      <span class="masthead__spacer"></span>
      <nav class="masthead__links" aria-label="Sections">
        <a href={withBase("/map/")}>Map</a>
        <a href={withBase("/extras/")}>Extras</a>
        <a href={withBase("/appendix/python/")}>Python</a>
        <a href={withBase("/appendix/math/")}>Maths</a>
        <a href={withBase("/setup/")}>Setup</a>
      </nav>
      <RuntimeWidget />
    </header>

    <slot />

    <footer class="footer">
      <span class="footer__pip"><Doodle name="pip" decorative /></span>
      <p>
        <strong>Gradient</strong> — how machines learn, from the beginning.
        Written for people who are new to all of it.
      </p>
      <nav aria-label="More">
        <a href={withBase("/colophon/")}>How this was made</a>
        <a href={withBase("/setup/")}>Setup</a>
        <a href={withBase("/map/")}>The map</a>
      </nav>
      <span class="footer__ver">{VERSION_LABEL}</span>
    </footer>

    <script>
      import "../scripts/client";
    </script>
  </body>
</html>
