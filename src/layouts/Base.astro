---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import RuntimeWidget from "../components/RuntimeWidget.astro";
import Doodle from "../components/Doodle.astro";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const {
  title,
  description = "A friendly, ground-up path into machine learning — sixteen chapters, all of them runnable.",
} = Astro.props;
const full = title === "Gradient" ? title : `${title} · Gradient`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <!-- Pyodide is fetched only when a cell runs; warm the connection early. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <!--
      One filter, applied to every drawing on the site. The turbulence displaces
      each path by a pixel or so, which is the whole trick: geometrically exact
      shapes come out looking like somebody drew them, and they all look like
      the *same* somebody.
    -->
    <svg class="svg-defs" aria-hidden="true" focusable="false">
      <filter id="pencil" x="-8%" y="-8%" width="116%" height="116%"
              filterUnits="objectBoundingBox">
        <feTurbulence type="fractalNoise" baseFrequency="0.028" numOctaves="3"
                      seed="7" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.7"
                           xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <header class="masthead">
      <button class="nav-toggle" type="button" aria-expanded="false" aria-label="Toggle chapter list">
        ☰ <span>Chapters</span>
      </button>
      <a class="masthead__brand" href="/">
        <span class="masthead__mark"><Doodle name="pip" decorative /></span>
        <span class="masthead__name">Gradient</span>
        <span class="masthead__tag">machine learning, from the ground up</span>
      </a>
      <span class="masthead__spacer"></span>
      <nav class="masthead__links" aria-label="Sections">
        <a href="/map/">Map</a>
        <a href="/extras/">Extras</a>
        <a href="/appendix/python/">Python</a>
        <a href="/appendix/math/">Maths</a>
        <a href="/setup/">Setup</a>
      </nav>
      <RuntimeWidget />
    </header>

    <slot />

    <script>
      import "../scripts/client";
    </script>
  </body>
</html>
