---
import { getCollection, render } from "astro:content";
import Doc from "../../layouts/Doc.astro";
import { inlineCode } from "../../lib/inline";
import Doodle from "../../components/Doodle.astro";

const entries = (await getCollection("py")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const libs = [...new Set(entries.map((e) => e.data.lib))].sort();
const rendered = await Promise.all(
  entries.map(async (e) => ({ entry: e, Content: (await render(e)).Content })),
);
---

<Doc
  title="The Python we use"
  current="appendix-python"
  description="A searchable reference for Python terms and examples used in the lessons."
>
  <div class="opener">
    <div>
      <h1>The Python we use</h1>
      <p class="lede">
        Short explanations and examples for the Python used in the course.
      </p>
    </div>
    <div class="opener__art"><Doodle name="snake" /></div>
  </div>

  <p>
    Use the search box to find a Python term from a lesson. Each entry gives a
    short definition and, where useful, a small example.
  </p>

  <p>
    Notes for readers with programming experience are optional and folded shut.
  </p>

  <div class="filterbar">
    <input type="search" placeholder="Filter entries…" aria-label="Filter Python entries" />
    {libs.map((lib) => (
      <button class="chip" data-lib={lib} aria-pressed="false" type="button">{lib}</button>
    ))}
  </div>

  {
    rendered.map(({ entry, Content }) => {
      const d = entry.data;
      return (
        <article
          class="entry"
          id={entry.id}
          data-lib={d.lib}
          data-search={`${d.title} ${d.summary} ${d.signature ?? ""} ${d.rust ?? ""}`}
        >
          <div class="entry__head">
            <h2>{d.title}</h2>
            <span class="refcard__lib" style="margin:0">{d.lib}</span>
            {d.since && <span style="font-family:var(--sans);font-size:.72rem;color:var(--ink-4)">since {d.since}</span>}
          </div>

          {d.signature && <pre class="refcard__sig" style="max-width:none">{d.signature}</pre>}
          <p set:html={inlineCode(d.summary)} />
          {d.example && <pre class="refcard__example" style="max-width:none">{d.example}</pre>}
          {d.output && <div class="refcard__out">{d.output}</div>}

          {d.rust && (
            <details class="aside aside--rust">
              <summary>
                <span class="aside__label">If you already write code</span>
                <span class="aside__hint">a note for Rust programmers</span>
              </summary>
              <div class="aside__body">
                <p style="margin:0" set:html={inlineCode(d.rust)} />
                {d.rustCode && <pre style="margin:.6rem 0 0;background:#fdf7f4;border-color:#f0dbd1">{d.rustCode}</pre>}
              </div>
            </details>
          )}

          <Content />

          {d.docs && (
            <p style="font-family:var(--sans);font-size:.8rem">
              <a href={d.docs} target="_blank" rel="noopener">{d.docsLabel ?? "Official documentation ↗"}</a>
            </p>
          )}
        </article>
      );
    })
  }
</Doc>
