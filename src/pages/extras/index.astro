---
import { getCollection } from "astro:content";
import Doc from "../../layouts/Doc.astro";
import Doodle from "../../components/Doodle.astro";

const extras = (await getCollection("extras", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const KINDS = [
  { id: "theory", title: "Theory and explanations", gist: "Work through the ideas and mathematics behind common models and training methods." },
  { id: "sibling", title: "Other methods", gist: "Explore useful approaches that need more time than the main course allows." },
  { id: "craft", title: "Practical work", gist: "Prepare data, debug models, and improve speed before deployment." },
  { id: "history", title: "History", gist: "See how earlier ideas and computing advances shaped modern machine learning." },
  { id: "culture", title: "Research and effects", gist: "Learn how research is evaluated and how machine learning systems can affect people." },
];
const total = extras.reduce((n, e) => n + e.data.minutes, 0);
import { withBase } from "../../lib/base";
---

<Doc title="Extras" description="Optional articles on machine learning theory, methods, practice, research, and social effects.">
  <div class="opener">
    <div>
      <h1>Extras</h1>
      <p class="lede">
        Optional guides for topics you want to explore in more depth.
      </p>
    </div>
    <div class="opener__art"><Doodle name="seedling" /></div>
  </div>

  <p>
    The main chapters introduce the core ideas and how to use them. These
    additional articles explain related methods, practical skills, and questions
    about research and impact. You can read one after the chapter it relates to,
    or choose a topic from the list below. None is required to follow the course.
  </p>
  <p>
    There are {extras.length} articles, about {Math.round(total / 60)} hours in
    total. Choose the subjects that match your questions.
  </p>

  {
    KINDS.map((kind) => {
      const items = extras.filter((e) => e.data.kind === kind.id);
      if (!items.length) return null;
      return (
        <section>
          <h2 id={kind.id}>{kind.title}</h2>
          <p>{kind.gist}</p>
          <ul class="extras-grid">
            {items.map((e) => (
              <li>
                <a class="extra-card" href={withBase(`/extras/${e.id}/`)}>
                  <span class="extra-card__title">{e.data.title}</span>
                  <span class="extra-card__blurb">{e.data.blurb}</span>
                  <span class="extra-card__meta">
                    <span class="extra-card__tag">{e.data.minutes} min</span>
                    {e.data.after && <span>after chapter {e.data.after.slice(0, 2)}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</Doc>
