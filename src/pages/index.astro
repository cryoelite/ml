---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ConceptMap from "../components/ConceptMap.astro";
import Doodle from "../components/Doodle.astro";
import FruitDemo from "../components/FruitDemo.astro";
import { withBase } from "../lib/base";

const chapters = (await getCollection("chapters", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const first = chapters[0];
const PARTS = [
  { id: "orientation", art: "inversion", title: "Start with the basics", aim: "Meet machine learning, try a model, learn enough Python to follow along, and decide when a problem needs a model." },
  { id: "foundations", art: "hill", title: "Learn how models improve", aim: "Fit simple models, check them on new examples, and compare common approaches." },
  { id: "deep-learning", art: "layers", title: "Build neural networks", aim: "See how a network learns, then use PyTorch for images and other data." },
  { id: "frontier", art: "beam", title: "Explore modern AI", aim: "Learn about embeddings, attention, transformers, and language models." },
  { id: "practice", art: "ship", title: "Use what you learned", aim: "Choose a useful metric, check real-world risks, and keep learning from papers and projects." },
];
const ROUTES = [
  { label: "I am new to all of this", detail: "Follow the full path in order. The first chapters explain the ideas and the Python as you need them.", href: first ? `/learn/${first.id}/` : "/", cta: "Start with chapter 1", tone: "green" },
  { label: "I have a data problem", detail: "If you know a little Python, start by defining the task and checking the data. New to code? Read chapters 1–2 first.", href: "/learn/03-the-shape-of-problems/", cta: "Plan a first project", tone: "blue" },
  { label: "I want to learn deep learning", detail: "After chapters 1–7, build a neural network, use PyTorch, and explore vision and language models.", href: "/learn/08-neural-networks/", cta: "Continue with chapter 8", tone: "purple" },
  { label: "I want to learn about language models", detail: "After chapters 1–10, learn about embeddings, attention, transformers, and next-token prediction.", href: "/learn/12-embeddings-and-tabular/", cta: "Continue with chapter 12", tone: "rose" },
];
const AVENUES = [
  { name: "Prediction from tables", description: "Estimate a number or choose a label from rows of data. Try linear models, trees, and boosted trees.", href: "/learn/04-your-first-model/", tag: "Classical ML" },
  { name: "Images", description: "Classify or detect objects in photos. Reuse a trained model before training from scratch.", href: "/learn/11-vision-and-transfer/", tag: "Computer vision" },
  { name: "Audio and speech", description: "Transcribe speech, identify sounds, or generate audio with a model trained for that task.", href: "/map/", tag: "Speech and audio" },
  { name: "Text and language", description: "Search, classify, summarize, translate, or generate text with language models and other NLP tools.", href: "/learn/13-attention-and-transformers/", tag: "NLP & LLMs" },
  { name: "Groups and patterns", description: "Find similar examples, reduce many measurements to a smaller view, or flag unusual cases without labels.", href: "/learn/15-unsupervised-and-the-rest/", tag: "Unsupervised learning" },
  { name: "Forecasting", description: "Estimate future values from measurements collected over time, such as demand or energy use.", href: "/learn/15-unsupervised-and-the-rest/", tag: "Time series" },
  { name: "Recommendations", description: "Use past choices to rank items a person may want next. Embeddings are one common building block.", href: "/learn/12-embeddings-and-tabular/", tag: "Ranking & retrieval" },
  { name: "Actions over time", description: "Train an agent to choose actions from feedback. This is reinforcement learning, and it needs careful testing.", href: "/extras/reinforcement-learning/", tag: "Reinforcement learning" },
];

const USE_MODES = [
  { title: "Use a trained model", text: "Start with a model already built into a tool or available through an API. Common tasks include summarizing text, transcribing audio, searching documents, and labeling images. Check its answers on examples like yours." },
  { title: "Adapt a model", text: "Reuse a trained model and adjust it for your task with examples from your domain. This can help when the new task is close to what the model already learned." },
  { title: "Train a model", text: "Fit a model on your own labelled data when you need a specific prediction. Begin with a simple baseline and compare it on data held out from training." },
];
const STEPS = [
  { n: "01", title: "Choose a question", text: "Name the decision or task. Decide who will use the result and what a wrong answer costs." },
  { n: "02", title: "Check the examples", text: "Collect representative data, inspect it, and make sure the target is available at prediction time." },
  { n: "03", title: "Make a baseline", text: "Start with a simple rule or model. It gives you a result to beat and helps catch data mistakes." },
  { n: "04", title: "Test fairly", text: "Hold out examples the model did not train on. Pick a metric that reflects the real cost of its errors." },
  { n: "05", title: "Use and monitor it", text: "Show people where the model is uncertain. Watch for changing data, new failure cases, and unequal effects." },
];
---

<Base title="Gradient" description="A practical, beginner-friendly guide to machine learning. Start with a model you can run in your browser, then choose where to go next.">
  <main class="home home-v3" id="main">
    <section class="hero hero-v3" aria-labelledby="home-title">
      <div class="hero-v3__copy">
        <p class="home__eyebrow">Machine learning, explained by doing</p>
        <h1 class="home__title" id="home-title">Learn how machines learn.</h1>
        <p class="home__lede">Start with a working model. Learn what it can do, where it fits, and how to tell whether it is useful. No programming experience needed; most examples run right here in your browser.</p>
        <div class="home__cta">
          {first && <a class="btn btn--primary" href={withBase(`/learn/${first.id}/`)}>Start learning <span aria-hidden="true">→</span></a>}
          <a class="btn btn--ghost" href="#choose-a-path">Choose a path</a>
        </div>
        <p class="hero-v3__note"><span aria-hidden="true">●</span> Free to read · No sign-in · No setup for most lessons</p>
      </div>
      <div class="hero-v3__art" aria-hidden="true"><Doodle name="pipWave" /></div>
      <div class="hero-v3__facts" aria-label="Course details">
        <span><strong>{chapters.length}</strong> chapters</span>
        <span><strong>In-browser</strong> Python practice</span>
        <span><strong>Beginner</strong> friendly</span>
      </div>
    </section>

    <section class="home-section home-intro" aria-labelledby="ml-title">
      <div class="section-kicker">First, the idea</div>
      <h2 id="ml-title">What is machine learning?</h2>
      <p>In regular programming, a person writes the rules. In machine learning, a person gives a program examples and a way to measure its mistakes. The program adjusts its internal numbers until it can make useful predictions on new examples.</p>
      <p>For example, show a model many labelled photos of cats and dogs. It can learn patterns that help it label another photo. It does not understand animals as a person does, and it can still be wrong. The examples and the test matter as much as the model.</p>
      <div class="definition-row">
        <div><strong>Artificial intelligence</strong><span>A broad name for computer systems that do tasks associated with human judgment or perception.</span></div>
        <div><strong>Machine learning</strong><span>A way to build some of those systems by learning patterns from data.</span></div>
        <div><strong>Deep learning</strong><span>Machine learning with neural networks that have many layers.</span></div>
      </div>
      <p class="home-inline-note">A useful rule: use ordinary code when you can write the rules clearly. Consider ML when examples are available, the pattern is hard to describe, and a wrong answer can be checked or handled.</p>
    </section>

    <section class="home-demo home-section" aria-labelledby="demo-title">
      <div class="home-demo__copy">
        <div class="section-kicker">Try a model</div>
        <h2 id="demo-title">Teach it to sort fruit.</h2>
        <p>Each dot is a piece of fruit. The two measurements are sweetness and size. Teach the model from the labelled examples, then click a new point to see its guess.</p>
        <p>This small example shows the basic loop: give examples, measure mistakes, adjust the model, and check a new case.</p>
      </div>
      <FruitDemo />
    </section>

    <section class="home-section" id="choose-a-path" aria-labelledby="paths-title">
      <div class="section-kicker">Choose where to begin</div>
      <h2 id="paths-title">Pick the route that fits your goal.</h2>
      <p>You can read the whole course in order, or use one of these starting points. Every route links back to the same foundations.</p>
      <div class="route-grid">
        {ROUTES.map((route) => (
          <a class={`route-card route-card--${route.tone}`} href={withBase(route.href)}>
            <span class="route-card__label">{route.label}</span>
            <span class="route-card__detail">{route.detail}</span>
            <span class="route-card__link">{route.cta} <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-section" aria-labelledby="avenues-title">
      <div class="section-kicker">The field has many paths</div>
      <h2 id="avenues-title">What can you learn or build?</h2>
      <p>Machine learning is not one technique. Start with the kind of data and task you care about; the model family comes later.</p>
      <div class="avenue-grid">
        {AVENUES.map((avenue) => (
          <a class="avenue-card" href={withBase(avenue.href)}>
            <span class="avenue-card__tag">{avenue.tag}</span>
            <strong>{avenue.name}</strong>
            <span>{avenue.description}</span>
            <span class="avenue-card__link">Open this topic <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
      <p class="home-inline-note">Other important areas include forecasting, speech, robotics, scientific modeling, and generative media. The <a href={withBase("/map/")}>field map</a> shows how these areas connect.</p>
    </section>

    <section class="home-section practical-section" aria-labelledby="practical-title">
      <div class="section-kicker">Use it in practice</div>
      <h2 id="practical-title">You may not need to train a model.</h2>
      <p>Choose the lightest approach that solves the task. Start with an existing tool, adapt a model, or train one on your data.</p>
      <div class="use-grid">
        {USE_MODES.map((mode) => <article class="use-card"><h3>{mode.title}</h3><p>{mode.text}</p></article>)}
      </div>
      <h3 class="workflow-heading">For a project of your own, follow these steps.</h3>
      <p>Model training is one step in a larger process. Check the task, the data, and the costs before choosing an algorithm.</p>
      <ol class="workflow-list">
        {STEPS.map((step) => (
          <li><span class="workflow-list__n">{step.n}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>
        ))}
      </ol>
      <p class="home-inline-note">If you cannot name a useful decision, get representative examples, or check the result safely, pause before adding a model. A simpler rule or a better process may work better.</p>
      <a class="text-link" href={withBase("/learn/03-the-shape-of-problems/")}>Learn how to shape a problem <span aria-hidden="true">→</span></a>
    </section>

    <section class="home-section" aria-labelledby="course-title">
      <div class="section-kicker">The learning path</div>
      <h2 id="course-title">From first model to real use.</h2>
      <p>Take the chapters in order for a full introduction. Each part adds one idea and uses it in the next.</p>
      <div class="parts parts-v3">
        {PARTS.map((part, i) => {
          const items = chapters.filter((c) => c.data.part === part.id);
          if (!items.length) return null;
          return (
            <section class={`part part--${i}`}>
              <div class="part__head"><span class="part__art"><Doodle name={part.art} decorative /></span><h3>{part.title}</h3></div>
              <p>{part.aim}</p>
              <ol>{items.map((c) => <li><a href={withBase(`/learn/${c.id}/`)}>{c.data.title}</a></li>)}</ol>
            </section>
          );
        })}
      </div>
      <p class="home-inline-note">You can run most code with the <strong>Run</strong> button. Lessons that need PyTorch explain how to connect a local Python kernel. See the <a href={withBase("/setup/")}>setup guide</a> when you need it.</p>
    </section>

    <section class="home-section next-steps" aria-labelledby="next-title">
      <div>
        <div class="section-kicker">Keep going</div>
        <h2 id="next-title">Good next steps after this course.</h2>
        <p>Use these free, official resources to continue along the path you choose.</p>
      </div>
      <ul class="resource-list">
        <li><a href="https://course.fast.ai/" rel="noreferrer">Practical Deep Learning for Coders <span>Hands-on projects with fastai and PyTorch</span></a></li>
        <li><a href="https://developers.google.com/machine-learning/crash-course" rel="noreferrer">Google’s Machine Learning Crash Course <span>Interactive lessons on data, models, evaluation, and responsible ML</span></a></li>
        <li><a href="https://scikit-learn.org/stable/getting_started.html" rel="noreferrer">scikit-learn getting started <span>Classical models, preprocessing, and evaluation in Python</span></a></li>
        <li><a href="https://docs.pytorch.org/tutorials/beginner/basics/intro.html" rel="noreferrer">PyTorch: Learn the Basics <span>A complete deep learning workflow, step by step</span></a></li>
      </ul>
    </section>

    <section class="home-map" aria-labelledby="map-title">
      <div class="section-kicker">Zoom out</div>
      <h2 id="map-title">See how the pieces fit.</h2>
      <p>Use the map to explore the wider field. Solid nodes are covered here; dashed nodes point to topics beyond this course.</p>
      <ConceptMap compact />
      <a class="text-link" href={withBase("/map/")}>Open the full field map <span aria-hidden="true">→</span></a>
    </section>
  </main>
</Base>
