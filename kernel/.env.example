# Copy to .env and edit. All optional.

# The origin of the site you are reading. Required when the site is NOT on your
# own machine, otherwise the kernel rejects the browser's requests on CORS.
#   GRADIENT_SITE_ORIGIN=https://ml.example.com

# Change if 8899 is already taken. Whatever you set here, type the matching
# http://127.0.0.1:<port> into the site's runtime panel and press Test connection.
#   GRADIENT_KERNEL_PORT=8899

# Must match the token in the site's runtime panel. Change both together.
#   GRADIENT_KERNEL_TOKEN=gradient
